import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

global Theme {
    out property <color> bg: #0c0d11;
    out property <color> panel: #111318;
    out property <brush> card: @linear-gradient(180deg, #1a1d25 0%, #16181f 100%);
    out property <color> card-hover: #1e222b;
    out property <color> line: #23272f;
    out property <color> text: #eceef3;
    out property <color> muted: #8b92a3;
    out property <color> faint: #5c6373;
    out property <color> accent: #ff4d57;
    out property <color> accent-fill: #c4282d; // white text >= 4.5:1
    out property <color> good: #3ecf8e;
    out property <color> warn: #f5a524;
    out property <color> blue: #4c9dff;
}

component Icon inherits Path {
    in property <string> d;
    width: 18px; height: 18px;
    viewbox-width: 24; viewbox-height: 24;
    commands: d;
    fill: transparent;
    stroke-width: 1.7px;
}

component Card inherits Rectangle {
    in property <string> title;
    background: Theme.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        if title != "": Text { text: title; color: Theme.muted; font-size: 11px; font-weight: 600; letter-spacing: 0.6px; }
        @children
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    height: 38px;
    border-radius: 10px;
    background: active ? #1c1f27 : ta.has-hover ? #171a20 : transparent;
    animate background { duration: 120ms; }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: 12px; spacing: 12px;
        Icon { y: (parent.height - self.height) / 2; d: icon; stroke: active ? Theme.accent : Theme.muted; }
        Text { text: label; color: active ? Theme.text : Theme.muted; font-size: 13px; font-weight: active ? 600 : 500; vertical-alignment: center; }
    }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    border-radius: 10px;
    background: selected ? Theme.accent-fill : ta.pressed ? #2a2f3a : ta.has-hover && enabled ? #232731 : #1b1e26;
    border-width: 1px;
    border-color: selected ? Theme.accent-fill : Theme.line;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: 140ms; }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } mouse-cursor: root.enabled ? pointer : default; }
    Text { text: label; color: selected ? white : Theme.text; font-size: 13px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
}

// Ring gauge; `arc` and `track` are SVG paths in a 100x100 box built by the Rust side.
component Gauge inherits Card {
    in property <string> arc;
    in property <string> track;
    in property <string> value;
    in property <string> unit;
    in property <string> sub;
    in property <float> fill;
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: 76px; height: 76px;
            Path { width: 100%; height: 100%; viewbox-width: 100; viewbox-height: 100; commands: track; stroke: #262a34; stroke-width: 7px; fill: transparent; }
            if arc != "": Path { width: 100%; height: 100%; viewbox-width: 100; viewbox-height: 100; commands: arc; fill: transparent; stroke-width: 7px;
                stroke: fill > 0.85 ? Theme.accent : fill > 0.65 ? Theme.warn : Theme.good; }
            Text { text: value; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: unit; color: Theme.text; font-size: 14px; font-weight: 600; }
            Text { text: sub; color: Theme.muted; font-size: 12px; }
        }
    }
}

// 60-sample bar history (0..1, oldest first), newest bar at the right edge.
component Sparkline inherits Rectangle {
    in property <[float]> points;
    in property <color> stroke: Theme.accent;
    height: 70px;
    property <length> slot: self.width / 60;
    for v[i] in points: Rectangle {
        x: root.width - (points.length - i) * slot;
        width: max(1px, slot - 2px);
        height: max(2px, v * root.height);
        y: root.height - self.height;
        border-radius: 2px;
        background: stroke.with-alpha(0.35 + 0.65 * (i + 1) / max(1, points.length));
    }
}

component Unsupported inherits Card {
    Text { wrap: word-wrap; color: Theme.muted;
        text: "No register map matches this laptop's EC firmware, so these controls are hidden. Sensors and system stats still work."; }
}

export struct ScenarioItem { label: string, hint: string }
export struct LightItem { id: string, name: string, kind: string, supported: bool }

export component AppWindow inherits Window {
    title: "Kestrel";
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 880px;
    min-height: 580px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 13px;

    in property <bool> connected;
    in property <string> model-name: "Connecting…";
    in property <string> firmware;
    in property <bool> read-only: true;
    in property <bool> supported;
    property <bool> can-write: connected && supported && !read-only;
    in property <string> message;
    in property <[ScenarioItem]> scenarios;
    in property <int> scenario: -1;
    in property <string> cpu-temp: "–";
    in property <string> gpu-temp: "–";
    in property <float> cpu-temp-f;
    in property <float> gpu-temp-f;
    in property <string> cpu-arc;
    in property <string> gpu-arc;
    in property <string> load-arc;
    in property <string> ram-arc;
    in property <string> track;
    in property <string> cpu-fan: "–";
    in property <string> gpu-fan: "–";
    in property <float> cpu-load;
    in property <string> ram: "–";
    in property <float> ram-f;
    in property <string> battery: "–";
    in property <string> power-source;
    in property <[float]> cpu-history;
    in property <[float]> temp-history;
    in property <bool> has-boost;
    in property <bool> cooler-boost;
    in property <bool> has-charge;
    in property <int> charge-limit: 100;
    in property <bool> has-kbd;
    in property <int> kbd-level: -1;
    in property <int> kbd-max: 3;

    callback set-scenario(int);
    callback set-boost(bool);
    callback set-charge(int);
    callback set-kbd(int);
    in property <[LightItem]> lights;
    in property <[color]> swatches;
    in-out property <int> light-sel: 0;
    in-out property <int> light-swatch: 0;
    in-out property <int> light-bright: 100;
    callback load-lights();
    in-out property <int> auto-bat: -1;
    in-out property <int> auto-ac: -1;
    in-out property <bool> auto-60hz;
    in property <int> lid-ac: -1;
    in property <string> lid-error;
    in property <int> lid-dc: -1;
    callback set-auto(int, int, bool);
    callback set-lid(bool, int);
    in property <[string]> rules;
    in-out property <int> rule-scn: 0;
    callback add-rule(string, int);
    callback remove-rule(int);
    in property <string> gpu-name;
    in property <string> gpu-driver;
    in property <string> gpu-stats;
    in property <string> gpu-error;
    callback load-gpu();
    in property <[string]> drivers;
    in property <string> driver-status: "Not checked yet.";
    in property <bool> driver-busy;
    callback check-drivers();
    callback install-drivers();
    callback open-driver-page();
    callback set-light(string, int, int);
    callback restore();
    in property <bool> has-curve;
    in-out property <bool> curve-gpu;
    in-out property <bool> curve-ready;
    in property <[int]> curve-temps;
    in-out property <[int]> curve-speeds;
    callback load-curve(bool);
    callback apply-curve(bool, [int]);

    property <int> page: 0;
    property <[string]> pages: ["Dashboard", "Scenarios", "Fans", "Battery", "Lighting", "Drivers", "Settings"];
    property <[string]> subtitles: ["Live temperatures, fans and load", "Power and fan profiles", "Cooling and Cooler Boost", "Charging and power source", "Keyboard and RGB devices", "GPU status and driver updates", "Model, firmware and safety"];
    // Lucide-style 24x24 outline icons.
    property <[string]> icons: [
        "M3 13h8V3H3zM13 21h8V11h-8zM13 3v6h8V3zM3 21h8v-6H3z",
        "M13 2 3 14h9l-1 8 10-12h-9z",
        "M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M12 10c0-4 1-7 4-7s3 4-2 7M14 12c4 0 7 1 7 4s-4 3-7-2M12 14c0 4-1 7-4 7s-3-4 2-7M10 12c-4 0-7-1-7-4s4-3 7 2",
        "M3 7h15a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM22 11v2M6 10v4M10 10v4",
        "M2 6h20v12H2zM6 10h0M10 10h0M14 10h0M18 10h0M7 14h10",
        "M4 7h16v10H4zM8 7V4M12 7V4M16 7V4M8 20v-3M12 20v-3M16 20v-3M8 10h8v4H8z",
        "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z",
    ];

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: Theme.panel;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                HorizontalLayout {
                    padding-bottom: 22px; padding-left: 8px; padding-top: 4px; spacing: 10px;
                    Rectangle { width: 26px; height: 26px; border-radius: 8px;
                        background: @linear-gradient(135deg, #ff6a5c 0%, #d81f3a 100%);
                        Text { text: "K"; color: white; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                    Text { text: "Kestrel"; color: Theme.text; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                }
                for p[i] in pages: NavItem { label: p; icon: icons[i]; active: page == i; clicked => { page = i; } }
                Rectangle {}
                Rectangle {
                    border-radius: 12px; background: #16181e; border-width: 1px; border-color: Theme.line;
                    VerticalLayout { padding: 12px; spacing: 6px;
                        Text { text: model-name; color: Theme.text; font-size: 12px; font-weight: 600; wrap: word-wrap; }
                        HorizontalLayout { spacing: 6px;
                            Rectangle { width: 7px; height: 7px; y: 4px; border-radius: 3.5px;
                                background: connected && supported && !read-only ? Theme.good : connected ? Theme.warn : Theme.accent; }
                            Text { text: !connected ? "Service not running" : !supported ? "Unknown model" : read-only ? "Read-only" : "Connected";
                                   color: Theme.muted; font-size: 11px; } } }
                }
            }
        }

        VerticalLayout {
            padding: 28px;
            padding-top: 24px;
            spacing: 18px;
            VerticalLayout { spacing: 4px;
                Text { text: pages[page]; color: Theme.text; font-size: 24px; font-weight: 700; }
                Text { text: subtitles[page]; color: Theme.muted; font-size: 13px; } }
            if message != "": Rectangle {
                background: #2a1618; border-radius: 10px; height: 38px; border-width: 1px; border-color: #5a2328;
                Text { x: 14px; text: message; color: #ffb4b6; vertical-alignment: center; }
            }

            if page == 0: VerticalLayout {
                spacing: 16px;
                HorizontalLayout {
                    spacing: 16px;
                    Gauge { title: "CPU"; arc: cpu-arc; track: track; fill: cpu-temp-f; value: cpu-temp; unit: "°C"; sub: "Fan " + cpu-fan; }
                    Gauge { title: "GPU"; arc: gpu-arc; track: track; fill: gpu-temp-f; value: gpu-temp; unit: "°C"; sub: "Fan " + gpu-fan; }
                    Gauge { title: "CPU LOAD"; arc: load-arc; track: track; fill: cpu-load / 100; value: round(cpu-load); unit: "%"; sub: "All cores"; }
                    Gauge { title: "MEMORY"; arc: ram-arc; track: track; fill: ram-f; value: round(ram-f * 100); unit: "%"; sub: ram; }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Card { title: "CPU TEMPERATURE · 60 S"; Sparkline { points: temp-history; } }
                    Card { title: "CPU LOAD · 60 S"; Sparkline { points: cpu-history; stroke: Theme.blue; } }
                }
                HorizontalLayout {
                    spacing: 16px;
                    if supported: Card { title: "SCENARIO";
                        HorizontalLayout { spacing: 8px;
                            for s[i] in scenarios: Pill { label: s.label; selected: scenario == i; enabled: can-write; clicked => { set-scenario(i); } } } }
                    Card { title: "POWER";
                        HorizontalLayout { spacing: 10px;
                            Text { text: battery; color: Theme.text; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                            Text { text: power-source; color: Theme.muted; vertical-alignment: center; } } }
                }
                Rectangle {}
            }

            if page == 1: VerticalLayout {
                spacing: 12px;
                if connected && !supported: Unsupported {}
                for s[i] in supported ? scenarios : []: Rectangle {
                    height: 68px; border-radius: 14px;
                    background: scenario == i ? #24161a : sa.has-hover && can-write ? Theme.card-hover : #17191f;
                    border-width: 1px; border-color: scenario == i ? Theme.accent : Theme.line;
                    opacity: can-write ? 1 : 0.45;
                    animate background, border-color { duration: 140ms; }
                    sa := TouchArea { enabled: can-write; clicked => { set-scenario(i); } mouse-cursor: can-write ? pointer : default; }
                    HorizontalLayout { padding-left: 18px; padding-right: 18px; spacing: 14px;
                        Rectangle { width: 10px; height: 10px; y: (parent.height - 10px) / 2; border-radius: 5px;
                            background: scenario == i ? Theme.accent : transparent; border-width: 2px; border-color: scenario == i ? Theme.accent : Theme.faint; }
                        VerticalLayout { alignment: center; spacing: 3px;
                            Text { text: s.label; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: s.hint; color: Theme.muted; font-size: 12px; } } }
                }
                Rectangle {}
            }

            if page == 2: VerticalLayout {
                spacing: 16px;
                HorizontalLayout { spacing: 16px;
                    Gauge { title: "CPU FAN"; arc: cpu-arc; track: track; fill: cpu-temp-f; value: cpu-temp; unit: cpu-fan; sub: "CPU °C"; }
                    Gauge { title: "GPU FAN"; arc: gpu-arc; track: track; fill: gpu-temp-f; value: gpu-temp; unit: gpu-fan; sub: "GPU °C"; } }
                if connected && !supported: Unsupported {}
                if supported: Card { title: "COOLER BOOST";
                    HorizontalLayout { spacing: 8px; alignment: start;
                        Pill { width: 96px; label: "Off"; selected: !cooler-boost; enabled: has-boost && can-write; clicked => { set-boost(false); } }
                        Pill { width: 96px; label: "On"; selected: cooler-boost; enabled: has-boost && can-write; clicked => { set-boost(true); } } }
                    Text { text: "Runs both fans at full speed."; color: Theme.muted; font-size: 12px; } }
                if supported: Card { title: "FAN CURVE";
                    if !has-curve: Text { text: "No verified fan-curve table for this model yet."; color: Theme.muted; }
                    if has-curve: HorizontalLayout { spacing: 8px; alignment: start;
                        Pill { width: 96px; label: "CPU"; selected: !curve-gpu; clicked => { curve-gpu = false; curve-ready = false; load-curve(false); } }
                        Pill { width: 96px; label: "GPU"; selected: curve-gpu; clicked => { curve-gpu = true; curve-ready = false; load-curve(true); } } }
                    if has-curve: HorizontalLayout { spacing: 10px; min-height: 170px; vertical-stretch: 1;
                        for v[i] in curve-speeds: VerticalLayout { spacing: 6px;
                            Rectangle { background: #1b1e26; border-radius: 8px; border-width: 1px; border-color: Theme.line;
                                Rectangle { y: parent.height - self.height; height: parent.height * v / 100; border-radius: 8px;
                                    background: @linear-gradient(0deg, Theme.accent-fill, Theme.accent);
                                    animate height { duration: 120ms; easing: ease-out; } }
                                Text { y: 6px; text: v + "%"; color: Theme.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; }
                                TouchArea { enabled: can-write && curve-ready; mouse-cursor: can-write && curve-ready ? MouseCursor.ns-resize : MouseCursor.default;
                                    pointer-event(e) => { if e.kind == PointerEventKind.down { curve-speeds[i] = max(0, min(100, round((1 - self.mouse-y / self.height) * 20) * 5)); } }
                                    moved => { if self.pressed { curve-speeds[i] = max(0, min(100, round((1 - self.mouse-y / self.height) * 20) * 5)); } } } }
                            Text { text: i < curve-temps.length ? curve-temps[i] + " °C" : ""; color: Theme.muted; font-size: 11px; horizontal-alignment: center; } } }
                    if has-curve: HorizontalLayout { spacing: 8px; alignment: start;
                        Pill { width: 128px; label: "Apply curve"; selected: true; enabled: can-write && curve-ready; clicked => { curve-ready = false; apply-curve(curve-gpu, curve-speeds); } }
                        Pill { width: 96px; label: "Reload"; clicked => { curve-ready = false; load-curve(curve-gpu); } } }
                    if has-curve: Text { wrap: word-wrap; color: Theme.muted; font-size: 12px;
                        text: "Drag a bar to set fan speed. Speeds are kept rising left to right; temperature points stay as the firmware set them. Choosing a scenario returns fan control to the firmware. Laptops that only follow custom curves in Extreme (such as the Vector A16 HX) switch to Extreme when you apply. GIGABYTE laptops use one 15-point curve for both fans."; } }
                Rectangle {}
            }

            if page == 3: VerticalLayout {
                spacing: 16px;
                if connected && !supported: Unsupported {}
                if supported: Card { title: "CHARGE LIMIT";
                    HorizontalLayout { spacing: 8px; alignment: start;
                        for v in [60, 80, 100]: Pill { width: 96px; label: v + "%"; selected: charge-limit == v; enabled: has-charge && can-write; clicked => { set-charge(v); } } }
                    Text { text: "Stops charging at the limit. 80% is the best everyday setting for battery life."; color: Theme.muted; font-size: 12px; } }
                Card { title: "BATTERY";
                    HorizontalLayout { spacing: 10px;
                        Text { text: battery; color: Theme.text; font-size: 20px; font-weight: 700; }
                        Text { text: power-source; color: Theme.muted; vertical-alignment: center; } } }
                Rectangle {}
            }

            if page == 4: VerticalLayout {
                spacing: 16px;
                if connected && !supported: Unsupported {}
                if supported: Card { title: "KEYBOARD BACKLIGHT";
                    HorizontalLayout { spacing: 8px; alignment: start;
                        for v in kbd-max + 1: Pill { width: 72px; label: v == 0 ? "Off" : v; selected: kbd-level == v; enabled: has-kbd && can-write; clicked => { set-kbd(v); } } }
                    if !has-kbd: Text { text: "This model's backlight is not controlled through the EC."; color: Theme.muted; font-size: 12px; } }
                Card { title: "RGB DEVICES";
                    if lights.length == 0: Text { text: connected ? "No MSI or SteelSeries RGB devices found." : "Service offline."; color: Theme.muted; font-size: 12px; }
                    for d[i] in lights: HorizontalLayout { spacing: 10px; alignment: start;
                        Pill { width: 260px; label: d.name; selected: light-sel == i; enabled: d.supported; clicked => { light-sel = i; } }
                        Text { vertical-alignment: center; color: Theme.muted; font-size: 12px;
                            text: d.supported ? d.kind + "  " + d.id : "Not supported yet. Report " + d.id + " on GitHub."; } }
                    if lights.length > 0 && lights[light-sel].supported: VerticalLayout { spacing: 12px;
                        HorizontalLayout { spacing: 8px; alignment: start;
                            for c[i] in swatches: Rectangle { width: 32px; height: 32px; border-radius: 16px; background: c;
                                border-width: light-swatch == i ? 3px : 0px; border-color: Theme.text;
                                TouchArea { clicked => { light-swatch = i; } } } }
                        HorizontalLayout { spacing: 8px; alignment: start;
                            for v in [0, 25, 50, 75, 100]: Pill { width: 64px; label: v == 0 ? "Off" : v + "%"; selected: light-bright == v; clicked => { light-bright = v; } } }
                        HorizontalLayout { spacing: 8px; alignment: start;
                            Pill { width: 120px; label: "Apply"; selected: true; enabled: connected; clicked => { set-light(lights[light-sel].id, light-swatch, light-bright); } } } }
                    HorizontalLayout { alignment: start; Pill { width: 120px; label: "Rescan"; clicked => { load-lights(); } } } }
                Rectangle {}
            }

            if page == 5: VerticalLayout {
                spacing: 16px;
                Timer { interval: 2s; running: page == 5; triggered => { load-gpu(); } }
                Card { title: "GRAPHICS";
                    if gpu-name == "": Text { text: gpu-error == "" ? "Reading GPU…" : gpu-error; color: Theme.muted; }
                    if gpu-name != "": VerticalLayout { spacing: 6px;
                        Text { text: gpu-name; color: Theme.text; font-size: 16px; font-weight: 600; }
                        Text { text: gpu-stats; color: Theme.muted; font-size: 13px; } } }
                Card { title: "DRIVER UPDATES";
                    Text { wrap: word-wrap; color: Theme.muted; font-size: 12px;
                        text: "From Windows Update: Wi-Fi, Bluetooth, chipset, audio, graphics and other drivers for this laptop."; }
                    for d in drivers: Text { text: "• " + d; color: Theme.text; wrap: word-wrap; }
                    Text { text: driver-status; color: Theme.muted; wrap: word-wrap; }
                    HorizontalLayout { alignment: start; spacing: 8px;
                        Pill { width: 160px; label: driver-busy ? "Working…" : "Check for updates"; enabled: connected && !driver-busy; clicked => { check-drivers(); } }
                        if drivers.length > 0: Pill { width: 160px; label: "Install all"; selected: true; enabled: connected && !driver-busy; clicked => { install-drivers(); } } } }
                Card { title: "NVIDIA DRIVER";
                    Text { text: gpu-driver == "" ? "Not installed" : "Installed: " + gpu-driver; color: Theme.text; }
                    HorizontalLayout { alignment: start; spacing: 8px;
                        Pill { width: 200px; label: "Get the latest driver"; selected: true; clicked => { open-driver-page(); } } }
                    Text { wrap: word-wrap; color: Theme.muted; font-size: 12px;
                        text: "Opens NVIDIA's driver download page. Compare its version with the installed one above."; } }
                Rectangle {}
            }

            if page == 6: Flickable { VerticalLayout {
                spacing: 16px;
                Card { title: "THIS LAPTOP";
                    Text { text: model-name; color: Theme.text; font-size: 16px; font-weight: 600; }
                    Text { text: "EC firmware " + firmware; color: Theme.muted; }
                    if connected && !supported: Text { wrap: word-wrap; color: Theme.warn;
                        text: "Unknown model: no register map matches this firmware, so Kestrel only shows system stats."; }
                    if connected && supported && read-only: Text { wrap: word-wrap; color: Theme.warn;
                        text: "Read-only: this firmware's register map is not confirmed on owner hardware, so Kestrel only reads sensors."; } }
                Card { title: "POWER AUTOMATION";
                    Text { text: "On battery"; color: Theme.muted; font-size: 12px; }
                    HorizontalLayout { spacing: 8px; alignment: start;
                        Pill { width: 110px; label: "No change"; selected: auto-bat == -1; clicked => { auto-bat = -1; set-auto(auto-bat, auto-ac, auto-60hz); } }
                        for s[i] in scenarios: Pill { width: 110px; label: s.label; selected: auto-bat == i; enabled: supported && !read-only; clicked => { auto-bat = i; set-auto(auto-bat, auto-ac, auto-60hz); } } }
                    Text { text: "Plugged in"; color: Theme.muted; font-size: 12px; }
                    HorizontalLayout { spacing: 8px; alignment: start;
                        Pill { width: 110px; label: "No change"; selected: auto-ac == -1; clicked => { auto-ac = -1; set-auto(auto-bat, auto-ac, auto-60hz); } }
                        for s[i] in scenarios: Pill { width: 110px; label: s.label; selected: auto-ac == i; enabled: supported && !read-only; clicked => { auto-ac = i; set-auto(auto-bat, auto-ac, auto-60hz); } } }
                    HorizontalLayout { spacing: 8px; alignment: start;
                        Pill { width: 230px; label: auto-60hz ? "60 Hz on battery: on" : "60 Hz on battery: off"; selected: auto-60hz;
                            clicked => { auto-60hz = !auto-60hz; set-auto(auto-bat, auto-ac, auto-60hz); } } }
                    Text { wrap: word-wrap; color: Theme.muted; font-size: 12px;
                        text: "Applied by the tray when you plug in or unplug, so keep kestrel-tray running. 60 Hz returns to the highest rate on AC."; } }
                Card { title: "AUTO PROFILES";
                    Text { wrap: word-wrap; color: Theme.muted; font-size: 12px;
                        text: "While a listed program runs, the tray switches to its scenario, then switches back when it closes."; }
                    for r[i] in rules: HorizontalLayout { spacing: 10px; alignment: start;
                        Text { text: r; color: Theme.text; vertical-alignment: center; min-width: 300px; }
                        Pill { width: 90px; label: "Remove"; clicked => { remove-rule(i); } } }
                    HorizontalLayout { spacing: 8px; alignment: start;
                        Rectangle { width: 220px; height: 34px; border-radius: 8px; background: #0f1115; border-width: 1px; border-color: #2a2f3a;
                            exe-input := TextInput { x: 10px; width: parent.width - 20px; vertical-alignment: center; color: Theme.text; font-size: 13px; }
                            if exe-input.text == "": Text { x: 10px; text: "game.exe"; color: Theme.muted; vertical-alignment: center; font-size: 13px; } }
                        for s[i] in scenarios: Pill { width: 100px; label: s.label; selected: rule-scn == i; clicked => { rule-scn = i; } }
                        Pill { width: 80px; label: "Add"; selected: true; enabled: exe-input.text != "";
                            clicked => { add-rule(exe-input.text, rule-scn); exe-input.text = ""; } } } }
                Card { title: "WHEN I CLOSE THE LID";
                    Text { text: "On battery"; color: Theme.muted; font-size: 12px; }
                    HorizontalLayout { spacing: 8px; alignment: start;
                        for a[i] in ["Do nothing", "Sleep", "Hibernate", "Shut down"]: Pill { width: 110px; label: a; selected: lid-dc == i; enabled: lid-dc >= 0; clicked => { set-lid(false, i); } } }
                    Text { text: "Plugged in"; color: Theme.muted; font-size: 12px; }
                    HorizontalLayout { spacing: 8px; alignment: start;
                        for a[i] in ["Do nothing", "Sleep", "Hibernate", "Shut down"]: Pill { width: 110px; label: a; selected: lid-ac == i; enabled: lid-ac >= 0; clicked => { set-lid(true, i); } } }
                    if lid-ac < 0: Text { text: "Could not read the Windows power plan. " + lid-error; color: Theme.muted; font-size: 12px; wrap: word-wrap; } }
                if supported: Card { title: "SAFETY";
                    HorizontalLayout { alignment: start;
                        Pill { width: 230px; label: "Restore original EC values"; enabled: can-write; clicked => { restore(); } } }
                    Text { text: "Every register Kestrel changes is saved first and can be put back."; color: Theme.muted; font-size: 12px; } }
            } }
        }
    }
}
